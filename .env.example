# Copy to .env to override. Placeholders only; no secrets are required.
LLM_BASE_URL=http://ollama:11434/v1
# Only for a free-tier OpenAI-compatible endpoint instead of local Ollama (never commit a real key; .env is gitignored)
LLM_API_KEY=ollama
# Seconds per model call. CPU-only Ollama writes about 4 tokens/s, so long answers need minutes.
LLM_TIMEOUT=900
LLM_MODEL=qwen3:8b
ORCH_CONCURRENCY=1
FOUNDER_MODE=web
APP_PORT=8000
# qwen3 thinking off (auto = off for qwen3 models; true/false to force)
LLM_NO_THINK=auto
# Ollama server: context window (tokens) and how long the model stays loaded
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=30m
